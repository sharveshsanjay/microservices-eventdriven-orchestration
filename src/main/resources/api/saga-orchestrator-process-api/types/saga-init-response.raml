#%RAML 1.0 DataType
type: object
properties:
  sagaId:
    type: string
    example: "SAGA-2026-0000771"
  orderId:
    type: string
    example: "ORD-2026-1001"
  sagaState:
    type: string
    example: "STARTED"
  statusUrl:
    type: string
    example: "/api/v1/sagas/SAGA-2026-0000771"
  correlationId:
    type: string
    example: "6e0a9c34-71bd-4e28-b9f5-3c7188a0e412"