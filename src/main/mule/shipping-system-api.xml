<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:amqp="http://www.mulesoft.org/schema/mule/amqp"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
        http://www.mulesoft.org/schema/mule/amqp http://www.mulesoft.org/schema/mule/amqp/current/mule-amqp.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- Worker Flow: Listen for Dispatch Commands -->
    <flow name="shipping-dispatch-amqp-worker">
        <amqp:listener config-ref="RabbitMQ_Config" 
                       queueName="${queues.shipping.command}" 
                       ackMode="MANUAL" 
                       doc:name="Listen shipping.dispatch.command" />

        <set-variable variableName="ackId" value="#[attributes.ackId]" />
        <set-variable variableName="msgPayload" value="#[read(payload, 'application/json')]" />
        <set-variable variableName="sagaId" value="#[vars.msgPayload.sagaId]" />
        <set-variable variableName="stepId" value="#[vars.msgPayload.stepId]" />
        <set-variable variableName="orderId" value="#[vars.msgPayload.orderId]" />
        <set-variable variableName="correlationId" value="#[attributes.properties.correlationId default uuid()]" />
        <set-variable variableName="dedupKey" value="#[vars.stepId ++ '_DISPATCH']" />

		<!-- Check for Simulated Step 3 Failure -->
        <choice doc:name="Check for Simulated Failure">
            <when expression="#[vars.msgPayload.serviceLevel == 'CARRIER-OFFLINE']">
                <raise-error type="CUSTOM:CARRIER_OFFLINE" 
                             description="Logistics carrier offline or destination unserviceable" 
                             doc:name="Raise Shipping Error" />
            </when>
        </choice>
        
        <!-- Deduplication check -->
        <db:select config-ref="Shipping_DB_Config" target="cachedCommand" doc:name="Check Dedup">
            <db:sql><![CDATA[SELECT result_payload FROM processed_commands WHERE dedup_key = :dedupKey]]></db:sql>
            <db:input-parameters><![CDATA[#[{'dedupKey': vars.dedupKey}]]]></db:input-parameters>
        </db:select>

        <choice>
            <when expression="#[!isEmpty(vars.cachedCommand)]">
                <set-variable variableName="stepResult" value="#[read(vars.cachedCommand[0].result_payload, 'application/json')]" />
            </when>
            <otherwise>
                <set-variable variableName="dispatchId" value="#['DSP-' ++ now() as String {format: 'yyyy'} ++ '-' ++ upper(uuid()[0 to 5])]" />
                <set-variable variableName="trkNum" value="#['TRK-IN-' ++ upper(uuid()[0 to 7])]" />

                <try doc:name="Atomic Try Scope" transactionalAction="ALWAYS_BEGIN">
                    <db:insert config-ref="Shipping_DB_Config" doc:name="Insert Dispatch">
                        <db:sql><![CDATA[
                            INSERT INTO shipping_dispatches (
                                dispatch_id, order_id, tracking_number, service_level, 
                                recipient_address, status, created_at
                            ) VALUES (
                                :dId, :orderId, :trk, :lvl, :addr, 'DISPATCHED', CURRENT_TIMESTAMP
                            )
                        ]]></db:sql>
                        <db:input-parameters><![CDATA[#[{
                            'dId': vars.dispatchId,
                            'orderId': vars.orderId,
                            'trk': vars.trkNum,
                            'lvl': vars.msgPayload.serviceLevel default 'STANDARD',
                            'addr': write(vars.msgPayload.recipientAddress default {}, 'application/json')
                        }]]]></db:input-parameters>
                    </db:insert>

                    <ee:transform doc:name="Set Result Payload">
                        <ee:message />
                        <ee:variables>
                            <ee:set-variable variableName="stepResult"><![CDATA[%dw 2.0
                            output application/json
                            ---
                            {
                                dispatchId: vars.dispatchId,
                                trackingNumber: vars.trkNum,
                                carrier: "BlueDart",
                                status: "DISPATCHED"
                            }]]></ee:set-variable>
                        </ee:variables>
                    </ee:transform>

                    <db:insert config-ref="Shipping_DB_Config" doc:name="Record Dedup">
                        <db:sql><![CDATA[
                            INSERT INTO processed_commands (dedup_key, step_id, command_type, result_payload, processed_at)
                            VALUES (:dedupKey, :stepId, 'DISPATCH', :res, CURRENT_TIMESTAMP)
                        ]]></db:sql>
                        <db:input-parameters><![CDATA[#[{
                            'dedupKey': vars.dedupKey,
                            'stepId': vars.stepId,
                            'res': write(vars.stepResult, 'application/json')
                        }]]]></db:input-parameters>
                    </db:insert>
                </try>
            </otherwise>
        </choice>

        <!-- Publish Success Reply -->
        <amqp:publish config-ref="RabbitMQ_Config" doc:name="Publish shipping.dispatch.reply">
            <amqp:routing-keys>
                <amqp:routing-key value="${queues.shipping.reply}" />
            </amqp:routing-keys>
            <amqp:message>
                <amqp:body><![CDATA[#[write({
                    outcome: "SUCCESS",
                    sagaId: vars.sagaId,
                    stepId: vars.stepId,
                    orderId: vars.orderId,
                    result: vars.stepResult
                }, "application/json")]]]></amqp:body>
                <amqp:properties correlationId="#[vars.correlationId]" />
            </amqp:message>
        </amqp:publish>

        <amqp:ack ackId="#[vars.ackId]" doc:name="Ack Command" />

        <error-handler>
            <on-error-continue enableNotifications="true" logException="true">
                <amqp:publish config-ref="RabbitMQ_Config" doc:name="Publish Failure Reply">
                    <amqp:routing-keys>
                        <amqp:routing-key value="${queues.shipping.reply}" />
                    </amqp:routing-keys>
                    <amqp:message>
                        <amqp:body><![CDATA[#[write({
                            outcome: "FAILURE",
                            sagaId: vars.sagaId,
                            stepId: vars.stepId,
                            orderId: vars.orderId,
                            failureCode: "CARRIER_SERVICE_UNAVAILABLE",
                            failureMessage: error.description default "Logistics carrier connection failed"
                        }, "application/json")]]]></amqp:body>
                        <amqp:properties correlationId="#[vars.correlationId]" />
                    </amqp:message>
                </amqp:publish>
                <amqp:ack ackId="#[vars.ackId]" doc:name="Ack Failed Message" />
            </on-error-continue>
        </error-handler>
    </flow>

    <!-- Compensation Flow: Cancel Dispatch -->
    <flow name="shipping-cancel-amqp-worker">
        <amqp:listener config-ref="RabbitMQ_Config" 
                       queueName="${queues.shipping.compensate}" 
                       ackMode="MANUAL" 
                       doc:name="Listen shipping.cancel.command" />

        <set-variable variableName="ackId" value="#[attributes.ackId]" />
        <set-variable variableName="msgPayload" value="#[read(payload, 'application/json')]" />
        <set-variable variableName="dId" value="#[vars.msgPayload.dispatchId]" />
        <set-variable variableName="stepId" value="#[vars.msgPayload.stepId]" />
        <set-variable variableName="dedupKey" value="#[vars.stepId ++ '_CANCEL']" />

        <try doc:name="Atomic Try Scope" transactionalAction="ALWAYS_BEGIN">
            <db:update config-ref="Shipping_DB_Config" doc:name="Set Shipping CANCELLED">
                <db:sql><![CDATA[
                    UPDATE shipping_dispatches 
                    SET status = 'CANCELLED', cancelled_at = CURRENT_TIMESTAMP 
                    WHERE dispatch_id = :dId
                ]]></db:sql>
                <db:input-parameters><![CDATA[#[{'dId': vars.dId}]]]></db:input-parameters>
            </db:update>

            <db:insert config-ref="Shipping_DB_Config" doc:name="Record Dedup">
                <db:sql><![CDATA[
                    INSERT INTO processed_commands (dedup_key, step_id, command_type, result_payload, processed_at)
                    VALUES (:dedupKey, :stepId, 'COMPENSATE_CANCEL', '{"status":"CANCELLED"}', CURRENT_TIMESTAMP)
                ]]></db:sql>
                <db:input-parameters><![CDATA[#[{
                    'dedupKey': vars.dedupKey,
                    'stepId': vars.stepId
                }]]]></db:input-parameters>
            </db:insert>
        </try>

        <amqp:ack ackId="#[vars.ackId]" doc:name="Ack Cancel Message" />
    </flow>
</mule>