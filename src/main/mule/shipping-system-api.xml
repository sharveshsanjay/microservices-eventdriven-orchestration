<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:amqp="http://www.mulesoft.org/schema/mule/amqp"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
        http://www.mulesoft.org/schema/mule/amqp http://www.mulesoft.org/schema/mule/amqp/current/mule-amqp.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- Worker Flow: Listen for Dispatch Commands -->
    <flow name="shipping-dispatch-amqp-worker">
        <amqp:listener config-ref="RabbitMQ_Config" 
                       queueName="${queues.shipping.command}" 
                       ackMode="MANUAL" 
                       doc:name="Listen shipping.dispatch.command" />

        <!-- Consolidated Context -->
        <ee:transform doc:name="Init Worker Context">
            <ee:variables>
                <ee:set-variable variableName="tx"><![CDATA[%dw 2.0
output application/json
var msg = if (payload is Binary or payload is String) read(payload, 'application/json') else payload
var sId = msg.stepId default ""
---
{
    ackId: attributes.ackId,
    msgPayload: msg,
    sagaId: msg.sagaId,
    stepId: sId,
    orderId: msg.orderId,
    serviceLevel: msg.serviceLevel default "STANDARD",
    recipientAddress: msg.recipientAddress default {},
    correlationId: attributes.properties.correlationId default uuid(),
    dedupKey: sId ++ "_DISPATCH",
    dispatchId: "DSP-" ++ now() as String {format: 'yyyy'} ++ '-' ++ upper(uuid()[0 to 5]),
    trkNum: "TRK-IN-" ++ upper(uuid()[0 to 7])
}]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <!-- Simulated Step 3 Failure Trigger -->
        <choice doc:name="Check for Simulated Failure">
            <when expression="#[vars.tx.serviceLevel == 'CARRIER-OFFLINE']">
                <raise-error type="CUSTOM:CARRIER_OFFLINE" 
                             description="Logistics carrier offline or destination unserviceable" 
                             doc:name="Raise Shipping Error" />
            </when>
        </choice>

        <!-- Deduplication Check -->
        <db:select config-ref="Shipping_DB_Config" target="cachedCommand" doc:name="Check Dedup">
            <db:sql><![CDATA[SELECT result_payload FROM processed_commands WHERE dedup_key = :dedupKey]]></db:sql>
            <db:input-parameters><![CDATA[#[{'dedupKey': vars.tx.dedupKey}]]]></db:input-parameters>
        </db:select>

        <choice doc:name="Check Cached Command">
            <when expression="#[!isEmpty(vars.cachedCommand)]">
                <set-variable variableName="stepResult" value="#[read(vars.cachedCommand[0].result_payload, 'application/json')]" />
            </when>
            <otherwise>
                <try doc:name="Atomic Try Scope" transactionalAction="ALWAYS_BEGIN">
                    <db:insert config-ref="Shipping_DB_Config" doc:name="Insert Dispatch">
                        <db:sql><![CDATA[
                            INSERT INTO shipping_dispatches (
                                dispatch_id, order_id, tracking_number, service_level, 
                                recipient_address, status, created_at
                            ) VALUES (
                                :dId, :orderId, :trk, :lvl, :addr, 'DISPATCHED', CURRENT_TIMESTAMP
                            )
                        ]]></db:sql>
                        <db:input-parameters><![CDATA[#[{
                            'dId': vars.tx.dispatchId,
                            'orderId': vars.tx.orderId,
                            'trk': vars.tx.trkNum,
                            'lvl': vars.tx.serviceLevel,
                            'addr': write(vars.tx.recipientAddress, 'application/json')
                        }]]]></db:input-parameters>
                    </db:insert>

                    <ee:transform doc:name="Set Result Payload">
                        <ee:variables>
                            <ee:set-variable variableName="stepResult"><![CDATA[%dw 2.0
output application/json
---
{
    dispatchId: vars.tx.dispatchId,
    trackingNumber: vars.tx.trkNum,
    carrier: "BlueDart",
    status: "DISPATCHED"
}]]></ee:set-variable>
                        </ee:variables>
                    </ee:transform>

                    <db:insert config-ref="Shipping_DB_Config" doc:name="Record Dedup">
                        <db:sql><![CDATA[
                            INSERT INTO processed_commands (dedup_key, step_id, command_type, result_payload, processed_at)
                            VALUES (:dedupKey, :stepId, 'DISPATCH', :res, CURRENT_TIMESTAMP)
                        ]]></db:sql>
                        <db:input-parameters><![CDATA[#[{
                            'dedupKey': vars.tx.dedupKey,
                            'stepId': vars.tx.stepId,
                            'res': write(vars.stepResult, 'application/json')
                        }]]]></db:input-parameters>
                    </db:insert>
                </try>
            </otherwise>
        </choice>

        <!-- Publish Success Reply -->
        <amqp:publish config-ref="RabbitMQ_Config" doc:name="Publish shipping.dispatch.reply">
            <amqp:routing-keys>
                <amqp:routing-key value="${queues.shipping.reply}" />
            </amqp:routing-keys>
            <amqp:message>
                <amqp:body><![CDATA[#[write({
                    outcome: "SUCCESS",
                    sagaId: vars.tx.sagaId,
                    stepId: vars.tx.stepId,
                    orderId: vars.tx.orderId,
                    result: vars.stepResult
                }, "application/json")]]]></amqp:body>
                <amqp:properties correlationId="#[vars.tx.correlationId]" />
            </amqp:message>
        </amqp:publish>

        <amqp:ack ackId="#[vars.tx.ackId]" doc:name="Ack Command" />

        <error-handler>
            <on-error-continue enableNotifications="true" logException="true">
                <amqp:publish config-ref="RabbitMQ_Config" doc:name="Publish Failure Reply">
                    <amqp:routing-keys>
                        <amqp:routing-key value="${queues.shipping.reply}" />
                    </amqp:routing-keys>
                    <amqp:message>
                        <amqp:body><![CDATA[#[write({
                            outcome: "FAILURE",
                            sagaId: vars.tx.sagaId,
                            stepId: vars.tx.stepId,
                            orderId: vars.tx.orderId,
                            failureCode: "CARRIER_SERVICE_UNAVAILABLE",
                            failureMessage: error.description default "Logistics carrier connection failed"
                        }, "application/json")]]]></amqp:body>
                        <amqp:properties correlationId="#[vars.tx.correlationId default uuid()]" />
                    </amqp:message>
                </amqp:publish>
                <amqp:ack ackId="#[vars.tx.ackId default attributes.ackId]" doc:name="Ack Failed Message" />
            </on-error-continue>
        </error-handler>
    </flow>

    <!-- Compensation Flow: Cancel Dispatch -->
    <flow name="shipping-cancel-amqp-worker">
        <amqp:listener config-ref="RabbitMQ_Config" 
                       queueName="${queues.shipping.compensate}" 
                       ackMode="MANUAL" 
                       doc:name="Listen shipping.cancel.command" />

        <ee:transform doc:name="Init Compensation Context">
            <ee:variables>
                <ee:set-variable variableName="compTx"><![CDATA[%dw 2.0
output application/json
var msg = if (payload is Binary or payload is String) read(payload, 'application/json') else payload
var sId = msg.stepId default ""
---
{
    ackId: attributes.ackId,
    dId: msg.dispatchId,
    stepId: sId,
    dedupKey: sId ++ "_CANCEL"
}]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <try doc:name="Atomic Try Scope" transactionalAction="ALWAYS_BEGIN">
            <db:update config-ref="Shipping_DB_Config" doc:name="Set Shipping CANCELLED">
                <db:sql><![CDATA[
                    UPDATE shipping_dispatches 
                    SET status = 'CANCELLED', cancelled_at = CURRENT_TIMESTAMP 
                    WHERE dispatch_id = :dId
                ]]></db:sql>
                <db:input-parameters><![CDATA[#[{'dId': vars.compTx.dId}]]]></db:input-parameters>
            </db:update>

            <db:insert config-ref="Shipping_DB_Config" doc:name="Record Dedup">
                <db:sql><![CDATA[
                    INSERT INTO processed_commands (dedup_key, step_id, command_type, result_payload, processed_at)
                    VALUES (:dedupKey, :stepId, 'COMPENSATE_CANCEL', '{"status":"CANCELLED"}', CURRENT_TIMESTAMP)
                ]]></db:sql>
                <db:input-parameters><![CDATA[#[{
                    'dedupKey': vars.compTx.dedupKey,
                    'stepId': vars.compTx.stepId
                }]]]></db:input-parameters>
            </db:insert>
        </try>

        <amqp:ack ackId="#[vars.compTx.ackId]" doc:name="Ack Cancel Message" />
    </flow>
</mule>