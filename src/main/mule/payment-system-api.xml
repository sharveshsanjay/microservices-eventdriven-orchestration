<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:amqp="http://www.mulesoft.org/schema/mule/amqp"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
        http://www.mulesoft.org/schema/mule/amqp http://www.mulesoft.org/schema/mule/amqp/current/mule-amqp.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- Worker Flow: Listen for Charge Commands -->
    <flow name="payment-charge-amqp-worker">
        <amqp:listener config-ref="RabbitMQ_Config" 
                       queueName="${queues.payment.command}" 
                       ackMode="MANUAL" 
                       doc:name="Listen payment.charge.command" />

        <!-- Consolidated Context -->
        <ee:transform doc:name="Init Worker Context">
            <ee:variables>
                <ee:set-variable variableName="tx"><![CDATA[%dw 2.0
output application/json
var msg = if (payload is Binary or payload is String) read(payload, 'application/json') else payload
var sId = msg.stepId default ""
---
{
    ackId: attributes.ackId,
    msgPayload: msg,
    sagaId: msg.sagaId,
    stepId: sId,
    orderId: msg.orderId,
    amount: msg.amount,
    currency: msg.currency default "INR",
    cardToken: msg.cardToken default "",
    correlationId: attributes.properties.correlationId default uuid(),
    dedupKey: sId ++ "_CHARGE",
    paymentId: "PAY-" ++ now() as String {format: 'yyyy'} ++ '-' ++ upper(uuid()[0 to 5]),
    gatewayRef: "GTW-TXN-" ++ upper(uuid()[0 to 5])
}]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <!-- Simulated Step 2 Failure Trigger -->
        <choice doc:name="Check for Simulated Failure">
            <when expression="#[vars.tx.cardToken == 'TKN-DECLINE']">
                <raise-error type="CUSTOM:PAYMENT_DECLINED" 
                             description="Payment authorization declined: Insufficient funds or invalid card token" 
                             doc:name="Raise Payment Error" />
            </when>
        </choice>

        <!-- Deduplication Check -->
        <db:select config-ref="Payment_DB_Config" target="cachedCommand" doc:name="Check Dedup">
            <db:sql><![CDATA[SELECT result_payload FROM processed_commands WHERE dedup_key = :dedupKey]]></db:sql>
            <db:input-parameters><![CDATA[#[{'dedupKey': vars.tx.dedupKey}]]]></db:input-parameters>
        </db:select>

        <choice doc:name="Check Cached Command">
            <when expression="#[!isEmpty(vars.cachedCommand)]">
                <set-variable variableName="stepResult" value="#[read(vars.cachedCommand[0].result_payload, 'application/json')]" />
            </when>
            <otherwise>
                <try doc:name="Atomic Try Scope" transactionalAction="ALWAYS_BEGIN">
                    <db:insert config-ref="Payment_DB_Config" doc:name="Insert Transaction">
                        <db:sql><![CDATA[
                            INSERT INTO payment_transactions (
                                payment_id, order_id, amount, currency, status, gateway_ref, created_at
                            ) VALUES (
                                :pId, :orderId, :amt, :curr, 'CHARGED', :gwRef, CURRENT_TIMESTAMP
                            )
                        ]]></db:sql>
                        <db:input-parameters><![CDATA[#[{
                            'pId': vars.tx.paymentId,
                            'orderId': vars.tx.orderId,
                            'amt': vars.tx.amount,
                            'curr': vars.tx.currency,
                            'gwRef': vars.tx.gatewayRef
                        }]]]></db:input-parameters>
                    </db:insert>

                    <ee:transform doc:name="Set Result Payload">
                        <ee:variables>
                            <ee:set-variable variableName="stepResult"><![CDATA[%dw 2.0
output application/json
---
{
    paymentId: vars.tx.paymentId,
    orderId: vars.tx.orderId,
    status: "CHARGED",
    gatewayRef: vars.tx.gatewayRef
}]]></ee:set-variable>
                        </ee:variables>
                    </ee:transform>

                    <db:insert config-ref="Payment_DB_Config" doc:name="Record Dedup">
                        <db:sql><![CDATA[
                            INSERT INTO processed_commands (dedup_key, step_id, command_type, result_payload, processed_at)
                            VALUES (:dedupKey, :stepId, 'CHARGE', :res, CURRENT_TIMESTAMP)
                        ]]></db:sql>
                        <db:input-parameters><![CDATA[#[{
                            'dedupKey': vars.tx.dedupKey,
                            'stepId': vars.tx.stepId,
                            'res': write(vars.stepResult, 'application/json')
                        }]]]></db:input-parameters>
                    </db:insert>
                </try>
            </otherwise>
        </choice>

        <!-- Publish Success Reply -->
        <amqp:publish config-ref="RabbitMQ_Config" doc:name="Publish payment.charge.reply">
            <amqp:routing-keys>
                <amqp:routing-key value="${queues.payment.reply}" />
            </amqp:routing-keys>
            <amqp:message>
                <amqp:body><![CDATA[#[write({
                    outcome: "SUCCESS",
                    sagaId: vars.tx.sagaId,
                    stepId: vars.tx.stepId,
                    orderId: vars.tx.orderId,
                    result: vars.stepResult
                }, "application/json")]]]></amqp:body>
                <amqp:properties correlationId="#[vars.tx.correlationId]" />
            </amqp:message>
        </amqp:publish>

        <amqp:ack ackId="#[vars.tx.ackId]" doc:name="Ack Command" />

        <error-handler>
            <on-error-continue enableNotifications="true" logException="true">
                <amqp:publish config-ref="RabbitMQ_Config" doc:name="Publish Failure Reply">
                    <amqp:routing-keys>
                        <amqp:routing-key value="${queues.payment.reply}" />
                    </amqp:routing-keys>
                    <amqp:message>
                        <amqp:body><![CDATA[#[write({
                            outcome: "FAILURE",
                            sagaId: vars.tx.sagaId,
                            stepId: vars.tx.stepId,
                            orderId: vars.tx.orderId,
                            failureCode: "PAYMENT_DECLINED",
                            failureMessage: error.description default "Payment gateway authorization declined"
                        }, "application/json")]]]></amqp:body>
                        <amqp:properties correlationId="#[vars.tx.correlationId default uuid()]" />
                    </amqp:message>
                </amqp:publish>
                <amqp:ack ackId="#[vars.tx.ackId default attributes.ackId]" doc:name="Ack Failed Message" />
            </on-error-continue>
        </error-handler>
    </flow>

    <!-- Compensation Flow: Refund Payment -->
    <flow name="payment-refund-amqp-worker">
        <amqp:listener config-ref="RabbitMQ_Config" 
                       queueName="${queues.payment.compensate}" 
                       ackMode="MANUAL" 
                       doc:name="Listen payment.refund.command" />

        <ee:transform doc:name="Init Compensation Context">
            <ee:variables>
                <ee:set-variable variableName="compTx"><![CDATA[%dw 2.0
output application/json
var msg = if (payload is Binary or payload is String) read(payload, 'application/json') else payload
var sId = msg.stepId default ""
---
{
    ackId: attributes.ackId,
    pId: msg.paymentId,
    stepId: sId,
    refundId: "REF-" ++ now() as String {format: 'yyyy'} ++ '-' ++ upper(uuid()[0 to 5]),
    dedupKey: sId ++ "_REFUND"
}]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <try doc:name="Atomic Try Scope" transactionalAction="ALWAYS_BEGIN">
            <db:update config-ref="Payment_DB_Config" doc:name="Set Payment REFUNDED">
                <db:sql><![CDATA[
                    UPDATE payment_transactions 
                    SET status = 'REFUNDED', refund_ref = :refId, refunded_at = CURRENT_TIMESTAMP 
                    WHERE payment_id = :pId
                ]]></db:sql>
                <db:input-parameters><![CDATA[#[{
                    'pId': vars.compTx.pId,
                    'refId': vars.compTx.refundId
                }]]]></db:input-parameters>
            </db:update>

            <db:insert config-ref="Payment_DB_Config" doc:name="Record Dedup">
                <db:sql><![CDATA[
                    INSERT INTO processed_commands (dedup_key, step_id, command_type, result_payload, processed_at)
                    VALUES (:dedupKey, :stepId, 'COMPENSATE_REFUND', '{"status":"REFUNDED"}', CURRENT_TIMESTAMP)
                ]]></db:sql>
                <db:input-parameters><![CDATA[#[{
                    'dedupKey': vars.compTx.dedupKey,
                    'stepId': vars.compTx.stepId
                }]]]></db:input-parameters>
            </db:insert>
        </try>

        <amqp:ack ackId="#[vars.compTx.ackId]" doc:name="Ack Refund Message" />
    </flow>
</mule>